<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="12dp">
        <ImageView android:layout_width="38dp" android:layout_height="38dp"
            android:src="@drawable/logo" android:scaleType="centerCrop"
            android:layout_marginEnd="10dp" android:contentDescription="Logo" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Next Level" android:textSize="18sp" android:textStyle="bold"
            android:textColor="#FFFFFF" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <Button android:id="@+id/btnPremium" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="★ Premium" android:textSize="12sp"
            android:backgroundTint="@color/panel" android:textColor="@color/gray" />
    </LinearLayout>

    <FrameLayout android:id="@+id/container"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@color/black">
        <Button android:id="@+id/tabCriar" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="✎
Criar e Editar" android:textSize="11sp"
            android:backgroundTint="@color/black" android:textColor="@color/muted" />
        <Button android:id="@+id/tabDiario" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="☰
Diário" android:textSize="11sp"
            android:backgroundTint="@color/black" android:textColor="@color/muted" />
        <Button android:id="@+id/tabGeral" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="◧
Geral" android:textSize="11sp"
            android:backgroundTint="@color/black" android:textColor="@color/muted" />
    </LinearLayout>
</LinearLayout>
